# --- Database (required in production) -------------------------------------
# Neon Postgres connection string. When unset, the app runs on a seeded
# in-memory store (local development / demos).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth (required in production) ------------------------------------------
# Secret for signing session JWTs. Generate with: openssl rand -hex 32
TIPSO_JWT_SECRET=

# --- Google sign-in (optional — button hidden when unset) --------------------
# OAuth 2.0 Web Client ID from Google Cloud Console → Credentials.
# Add your domains (incl. https://<project>.vercel.app) to Authorized
# JavaScript origins. Same value in both vars.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# --- World Cup live fixtures (optional — seed fixtures used when unset) ------
# Free API key from https://www.football-data.org (free tier includes the
# FIFA World Cup). Real fixtures sync every 30 min; finished matches settle
# automatically into the public ledger.
FOOTBALL_DATA_API_KEY=

# --- nTZS WaaS treasury (optional — simulator used when unset) ---------------
# Credentials for the TIPSO master treasury wallet on nTZS.
# Until these are set, payments settle instantly via the built-in simulator.
NTZS_API_BASE_URL=
NTZS_API_KEY=
NTZS_TREASURY_WALLET_ID=
# Public URL nTZS should call when a collection settles:
# https://<your-domain>/api/webhooks/ntzs
NTZS_CALLBACK_URL=
# Shared secret used to verify webhook signatures
NTZS_WEBHOOK_SECRET=
